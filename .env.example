# ─────────────────────────────────────────────────────────────────────────────
# NoDalalTalks — environment configuration
# Copy to `.env.local` and fill in. Public (NEXT_PUBLIC_*) values ship to the
# browser; everything else stays server-only. No secrets are committed.
#
# PRODUCTION SETUP (M0 — one-time, requires the founder's Google account):
#   1. console.firebase.google.com → Add project (e.g. "nodalaltalks-prod").
#   2. Enable Authentication → Sign-in methods: Phone AND Email/Password.
#      NOTE: Phone-auth SMS requires the Blaze (pay-as-you-go) plan since 2024 —
#      add a card; cost is per-SMS (₹ trivial at beta scale). Everything else
#      stays within the free tier at 20 advisors / 100 buyers.
#   3. Create a Firestore database (production mode) + a Storage bucket.
#   4. Project settings → Add a Web app → copy the config values below.
#   5. Project settings → Service accounts → Generate private key → paste the
#      JSON as ONE line into FIREBASE_SERVICE_ACCOUNT.
#   6. Locally: `npx firebase login`, then
#      `npx firebase use <project-id>` and
#      `npx firebase deploy --only firestore:rules,firestore:indexes,storage`
#   7. Set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false and
#      NEXT_PUBLIC_EVENT_BACKEND=firestore, then verify phone-OTP signup
#      end-to-end with a real phone BEFORE inviting anyone (LAUNCH_CHECKLIST.md).
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web SDK (client) — wired in Feature 2
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Use the Firebase Local Emulator Suite during development (Feature 2).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Server-only: Firebase Admin credentials for privileged writes (wallets,
# transactions, notifications) and setting role custom claims. Paste the service
# account JSON as a single line. Against the emulator this can stay empty.
FIREBASE_SERVICE_ACCOUNT=

# Analytics event backend: "local" (MVP/dev) | "firestore" (scale).
# Mirrors NDT.config.backend in analytics.js — same contract, typed.
NEXT_PUBLIC_EVENT_BACKEND=local

# Payments — provider is swappable behind the PaymentGateway port.
# "placeholder" | "razorpay" | "stripe"
PAYMENT_PROVIDER=placeholder
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Calling — swappable behind the CallService port.
# "placeholder" | "agora" | "twilio"
CALL_PROVIDER=placeholder
