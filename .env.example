# ─────────────────────────────────────────────────────────────────────────────
# NoDalalTalks — environment configuration
# Copy to `.env.local` and fill in. Public (NEXT_PUBLIC_*) values ship to the
# browser; everything else stays server-only. No secrets are committed.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web SDK (client) — wired in Feature 2
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Use the Firebase Local Emulator Suite during development (Feature 2).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Analytics event backend: "local" (MVP/dev) | "firestore" (scale).
# Mirrors NDT.config.backend in analytics.js — same contract, typed.
NEXT_PUBLIC_EVENT_BACKEND=local

# Payments — provider is swappable behind the PaymentGateway port.
# "placeholder" | "razorpay" | "stripe"
PAYMENT_PROVIDER=placeholder
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Calling — swappable behind the CallService port.
# "placeholder" | "agora" | "twilio"
CALL_PROVIDER=placeholder
